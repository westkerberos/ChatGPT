diff --git a/plugins/win-dshow/mjpeg-recorder.hpp b/plugins/win-dshow/mjpeg-recorder.hpp
new file mode 100644
--- /dev/null
+++ b/plugins/win-dshow/mjpeg-recorder.hpp
@@ -0,0 +1,45 @@
+#pragma once
+
+#include <obs.h>
+
+#include <cstddef>
+#include <cstdint>
+#include <mutex>
+#include <string>
+
+struct AVFormatContext;
+struct AVStream;
+
+class NativeMjpegRecorder {
+	AVFormatContext *format_ = nullptr;
+	AVStream *video_stream_ = nullptr;
+	AVStream *audio_stream_ = nullptr;
+	obs_source_t *audio_source_ = nullptr;
+	bool header_written_ = false;
+	int64_t frame_interval_ = 0;
+	int64_t frame_duration_ = 0;
+	uint64_t frame_index_ = 0;
+	uint64_t audio_frame_index_ = 0;
+	uint32_t audio_sample_rate_ = 48000;
+	bool diagnostic_have_first_ts_ = false;
+	int64_t diagnostic_first_ts_ = 0;
+	int64_t diagnostic_last_ts_ = 0;
+	uint64_t diagnostic_frame_count_ = 0;
+	uint64_t diagnostic_first_video_wall_ns_ = 0;
+	bool diagnostic_have_first_audio_ts_ = false;
+	uint64_t diagnostic_first_audio_ts_ = 0;
+	uint64_t diagnostic_last_audio_ts_ = 0;
+	std::string filename_;
+	mutable std::mutex mutex_;
+
+	static void AudioCaptureCallback(void *param, obs_source_t *source, const struct audio_data *audio, bool muted);
+	void WriteAudio(const struct audio_data *audio, bool muted);
+
+public:
+	~NativeMjpegRecorder();
+
+	bool Start(const char *directory, int width, int height, int64_t frame_interval, const char *audio_source_name);
+	void Write(const uint8_t *data, size_t size, int64_t ts);
+	void Stop();
+
+	bool Active() const
+	{
+		std::lock_guard<std::mutex> lock(mutex_);
+		return format_ != nullptr;
+	}
+};
diff --git a/plugins/win-dshow/mjpeg-recorder.cpp b/plugins/win-dshow/mjpeg-recorder.cpp
new file mode 100644
--- /dev/null
+++ b/plugins/win-dshow/mjpeg-recorder.cpp
@@ -0,0 +1,269 @@
+#include "mjpeg-recorder.hpp"
+
+#include <obs-module.h>
+#include <util/platform.h>
+
+extern "C" {
+#include <libavcodec/avcodec.h>
+#include <libavformat/avformat.h>
+#include <libavutil/avutil.h>
+}
+
+#include <windows.h>
+
+#include <algorithm>
+#include <climits>
+#include <cmath>
+#include <cstdio>
+#include <cstring>
+#include <ctime>
+#include <limits>
+#include <string>
+
+static constexpr AVRational DSHOW_TIME_BASE = {1, 10000000};
+static constexpr AVRational VIDEO_TIME_BASE = {1, 90000};
+
+static bool directory_exists(const char *directory)
+{
+	DWORD attrs = GetFileAttributesA(directory);
+	return attrs != INVALID_FILE_ATTRIBUTES && (attrs & FILE_ATTRIBUTE_DIRECTORY);
+}
+
+static std::string make_filename(const char *directory)
+{
+	if (!directory || !*directory || !directory_exists(directory))
+		return {};
+
+	std::time_t now = std::time(nullptr);
+	std::tm tm_now{};
+	localtime_s(&tm_now, &now);
+
+	char stamp[64] = {};
+	if (std::strftime(stamp, sizeof(stamp), "%Y-%m-%d_%H-%M-%S", &tm_now) == 0)
+		return {};
+
+	std::string prefix = std::string(directory);
+	const char last = prefix.empty() ? '\0' : prefix.back();
+	if (last != '\\' && last != '/')
+		prefix += '\\';
+
+	prefix += "El_Descorche_Facecam4K_" + std::string(stamp);
+
+	std::string filename = prefix + ".mov";
+	if (GetFileAttributesA(filename.c_str()) == INVALID_FILE_ATTRIBUTES)
+		return filename;
+
+	for (unsigned int i = 2; i < 10000; ++i) {
+		filename = prefix + "_" + std::to_string(i) + ".mov";
+		if (GetFileAttributesA(filename.c_str()) == INVALID_FILE_ATTRIBUTES)
+			return filename;
+	}
+
+	return {};
+}
+
+static int16_t float_to_s16(float value)
+{
+	value = std::clamp(value, -1.0f, 1.0f);
+	return (int16_t)std::lrintf(value * 32767.0f);
+}
+
+NativeMjpegRecorder::~NativeMjpegRecorder()
+{
+	Stop();
+}
+
+bool NativeMjpegRecorder::Start(const char *directory, int width, int height, int64_t frame_interval_value,
+				 const char *audio_source_name)
+{
+	Stop();
+
+	if (width <= 0 || height <= 0 || frame_interval_value <= 0)
+		return false;
+
+	filename_ = make_filename(directory);
+	if (filename_.empty()) {
+		blog(LOG_WARNING, "Native MJPEG recorder: output directory does not exist or filename unavailable");
+		return false;
+	}
+
+	int ret = avformat_alloc_output_context2(&format_, nullptr, "mov", filename_.c_str());
+	if (ret < 0 || !format_)
+		return false;
+
+	video_stream_ = avformat_new_stream(format_, nullptr);
+	if (!video_stream_) {
+		Stop();
+		return false;
+	}
+
+	video_stream_->time_base = VIDEO_TIME_BASE;
+	video_stream_->avg_frame_rate = AVRational{10000000, (int)frame_interval_value};
+	video_stream_->codecpar->codec_type = AVMEDIA_TYPE_VIDEO;
+	video_stream_->codecpar->codec_id = AV_CODEC_ID_MJPEG;
+	video_stream_->codecpar->codec_tag = 0;
+	video_stream_->codecpar->width = width;
+	video_stream_->codecpar->height = height;
+
+	audio_sample_rate_ = 48000;
+	obs_audio_info audio_info{};
+	if (obs_get_audio_info(&audio_info) && audio_info.samples_per_sec > 0)
+		audio_sample_rate_ = audio_info.samples_per_sec;
+
+	const char *resolved_audio_name = (audio_source_name && *audio_source_name) ? audio_source_name : "Mic/Aux";
+	obs_source_t *audio_source = obs_get_source_by_name(resolved_audio_name);
+	if (audio_source) {
+		audio_stream_ = avformat_new_stream(format_, nullptr);
+		if (audio_stream_) {
+			audio_stream_->time_base = AVRational{1, (int)audio_sample_rate_};
+			audio_stream_->codecpar->codec_type = AVMEDIA_TYPE_AUDIO;
+			audio_stream_->codecpar->codec_id = AV_CODEC_ID_PCM_S16LE;
+			audio_stream_->codecpar->codec_tag = 0;
+			audio_stream_->codecpar->sample_rate = (int)audio_sample_rate_;
+			audio_stream_->codecpar->format = AV_SAMPLE_FMT_S16;
+			av_channel_layout_default(&audio_stream_->codecpar->ch_layout, 2);
+		}
+	} else {
+		blog(LOG_WARNING, "Native MJPEG recorder: audio source '%s' was not found; recording video only",
+		     resolved_audio_name);
+	}
+
+	if (!(format_->oformat->flags & AVFMT_NOFILE)) {
+		ret = avio_open(&format_->pb, filename_.c_str(), AVIO_FLAG_WRITE);
+		if (ret < 0) {
+			if (audio_source)
+				obs_source_release(audio_source);
+			Stop();
+			return false;
+		}
+	}
+
+	ret = avformat_write_header(format_, nullptr);
+	if (ret < 0) {
+		if (audio_source)
+			obs_source_release(audio_source);
+		Stop();
+		return false;
+	}
+
+	header_written_ = true;
+	diagnostic_have_first_ts_ = false;
+	diagnostic_first_ts_ = 0;
+	diagnostic_last_ts_ = 0;
+	diagnostic_frame_count_ = 0;
+	diagnostic_first_video_wall_ns_ = 0;
+	diagnostic_have_first_audio_ts_ = false;
+	diagnostic_first_audio_ts_ = 0;
+	diagnostic_last_audio_ts_ = 0;
+	diagnostic_first_video_wall_ns_ = 0;
+	diagnostic_have_first_audio_ts_ = false;
+	diagnostic_first_audio_ts_ = 0;
+	diagnostic_last_audio_ts_ = 0;
+	frame_interval_ = frame_interval_value;
+	frame_duration_ = av_rescale_q(frame_interval_, DSHOW_TIME_BASE, video_stream_->time_base);
+	frame_index_ = 0;
+	audio_frame_index_ = 0;
+
+	if (audio_source && audio_stream_) {
+		audio_source_ = audio_source;
+		obs_source_add_audio_capture_callback(audio_source_, AudioCaptureCallback, this);
+	} else if (audio_source) {
+		obs_source_release(audio_source);
+	}
+
+	blog(LOG_INFO, "Native MJPEG recorder: started %dx%d at %.3f fps -> %s",
+	     width, height, 10000000.0 / double(frame_interval_value), filename_.c_str());
+
+	return true;
+}
+
+void NativeMjpegRecorder::Write(const uint8_t *data, size_t size, int64_t ts)
+{
+	std::lock_guard<std::mutex> lock(mutex_);
+
+	if (!format_ || !header_written_ || !video_stream_ || !data || size == 0 || size > INT_MAX)
+		return;
+
+	if (!diagnostic_have_first_ts_) {
+		diagnostic_first_ts_ = ts;
+		diagnostic_have_first_ts_ = true;
+		diagnostic_first_video_wall_ns_ = os_gettime_ns();
+	}
+	diagnostic_last_ts_ = ts;
+	++diagnostic_frame_count_;
+
+	AVPacket *packet = av_packet_alloc();
+	if (!packet)
+		return;
+
+	if (av_new_packet(packet, (int)size) < 0) {
+		av_packet_free(&packet);
+		return;
+	}
+
+	memcpy(packet->data, data, size);
+	packet->stream_index = video_stream_->index;
+	packet->pts = frame_index_ * frame_duration_;
+	packet->dts = packet->pts;
+	packet->duration = frame_duration_;
+	packet->flags |= AV_PKT_FLAG_KEY;
+
+	const int ret = av_interleaved_write_frame(format_, packet);
+	if (ret < 0)
+		blog(LOG_WARNING, "Native MJPEG recorder: video write failed: %d", ret);
+	else
+		++frame_index_;
+
+	av_packet_free(&packet);
+}
+
+void NativeMjpegRecorder::AudioCaptureCallback(void *param, obs_source_t *source,
+					       const struct audio_data *audio, bool muted)
+{
+	UNUSED_PARAMETER(source);
+
+	auto *recorder = static_cast<NativeMjpegRecorder *>(param);
+	if (recorder)
+		recorder->WriteAudio(audio, muted);
+}
+
+void NativeMjpegRecorder::WriteAudio(const struct audio_data *audio, bool muted)
+{
+	std::lock_guard<std::mutex> lock(mutex_);
+
+	if (!format_ || !header_written_ || !audio_stream_ || !audio || audio->frames == 0)
+		return;
+
+	if (!diagnostic_have_first_audio_ts_) {
+		diagnostic_first_audio_ts_ = audio->timestamp;
+		diagnostic_have_first_audio_ts_ = true;
+	}
+	diagnostic_last_audio_ts_ = audio->timestamp;
+
+	const uint64_t channels = 2;
+	const uint64_t frames = audio->frames;
+	if (frames > std::numeric_limits<uint32_t>::max())
+		return;
+
+	const size_t sample_count = (size_t)frames * (size_t)channels;
+	if (sample_count > (size_t)INT_MAX / sizeof(int16_t))
+		return;
+
+	AVPacket *packet = av_packet_alloc();
+	if (!packet)
+		return;
+
+	const int packet_size = (int)(sample_count * sizeof(int16_t));
+	if (av_new_packet(packet, packet_size) < 0) {
+		av_packet_free(&packet);
+		return;
+	}
+
+	int16_t *dst = reinterpret_cast<int16_t *>(packet->data);
+	const float *left = audio->data[0] ? reinterpret_cast<const float *>(audio->data[0]) : nullptr;
+	const float *right = audio->data[1] ? reinterpret_cast<const float *>(audio->data[1]) : left;
+
+	if (!left) {
+		memset(dst, 0, (size_t)packet_size);
+	} else {
+		for (uint32_t i = 0; i < audio->frames; ++i) {
+			const float l = muted ? 0.0f : left[i];
+			const float r = muted ? 0.0f : (right ? right[i] : left[i]);
+			dst[(size_t)i * 2] = float_to_s16(l);
+			dst[(size_t)i * 2 + 1] = float_to_s16(r);
+		}
+	}
+
+	packet->stream_index = audio_stream_->index;
+	packet->pts = (int64_t)audio_frame_index_;
+	packet->dts = packet->pts;
+	packet->duration = (int64_t)frames;
+	packet->flags |= AV_PKT_FLAG_KEY;
+
+	const int ret = av_interleaved_write_frame(format_, packet);
+	if (ret < 0)
+		blog(LOG_WARNING, "Native MJPEG recorder: audio write failed: %d", ret);
+	else
+		audio_frame_index_ += frames;
+
+	av_packet_free(&packet);
+}
+
+void NativeMjpegRecorder::Stop()
+{
+	obs_source_t *audio_source = audio_source_;
+	audio_source_ = nullptr;
+
+	if (audio_source) {
+		obs_source_remove_audio_capture_callback(audio_source, AudioCaptureCallback, this);
+		obs_source_release(audio_source);
+	}
+
+	std::lock_guard<std::mutex> lock(mutex_);
+
+	if (!format_)
+		return;
+
+	if (diagnostic_have_first_ts_ && diagnostic_last_ts_ >= diagnostic_first_ts_) {
+		const double elapsed = double(diagnostic_last_ts_ - diagnostic_first_ts_) / 10000000.0;
+		const double effective_fps = diagnostic_frame_count_ > 1 && elapsed > 0.0
+			? double(diagnostic_frame_count_ - 1) / elapsed
+			: 0.0;
+		blog(LOG_INFO,
+		     "Native MJPEG recorder: DIAG frames=%llu first_ts=%lld last_ts=%lld elapsed=%.6f effective_fps=%.3f",
+		     (unsigned long long)diagnostic_frame_count_,
+		     (long long)diagnostic_first_ts_,
+		     (long long)diagnostic_last_ts_, elapsed, effective_fps);
+	}
+
+	if (diagnostic_have_first_audio_ts_ && diagnostic_first_video_wall_ns_ > 0) {
+		const double first_audio_delta_ms =
+			(double)((int64_t)diagnostic_first_audio_ts_ - (int64_t)diagnostic_first_video_wall_ns_) / 1000000.0;
+		blog(LOG_INFO,
+		     "Native MJPEG recorder: DIAG audio_first=%llu audio_last=%llu first_audio_minus_first_video_wall=%.3f ms",
+		     (unsigned long long)diagnostic_first_audio_ts_,
+		     (unsigned long long)diagnostic_last_audio_ts_, first_audio_delta_ms);
+	}
+
+	if (header_written_)
+		av_write_trailer(format_);
+
+	if (format_->pb && !(format_->oformat->flags & AVFMT_NOFILE))
+		avio_closep(&format_->pb);
+
+	avformat_free_context(format_);
+	format_ = nullptr;
+	video_stream_ = nullptr;
+	audio_stream_ = nullptr;
+	header_written_ = false;
+	frame_interval_ = 0;
+	frame_duration_ = 0;
+	frame_index_ = 0;
+	audio_frame_index_ = 0;
+	diagnostic_have_first_ts_ = false;
+	diagnostic_first_ts_ = 0;
+	diagnostic_last_ts_ = 0;
+	diagnostic_frame_count_ = 0;
+
+	if (!filename_.empty())
+		blog(LOG_INFO, "Native MJPEG recorder: stopped -> %s", filename_.c_str());
+
+	filename_.clear();
+}
